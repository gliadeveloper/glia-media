# HLS 전용 비공개 버킷입니다. online-glia 이름과 LMS 키는 넣지 않습니다.
# 이 파일을 복사해 .env 로 저장합니다. .env 는 git에 올라가지 않습니다.
GLIA_R2_ENDPOINT=https://<계정>.r2.cloudflarestorage.com
GLIA_R2_BUCKET=glia-media
GLIA_R2_ACCESS_KEY_ID=
GLIA_R2_SECRET_ACCESS_KEY=
GLIA_R2_REGION=auto

# LMS와 주고받는 내부 연결입니다. 값은 비워 두고, 비밀은 .env 에만 넣습니다.
GLIA_LMS_TOKEN=
GLIA_LMS_CALLBACK_URL=
GLIA_LISTEN=127.0.0.1:8765
GLIA_PLAYBACK_BASE_URL=https://glia-media-playback.glia-media.workers.dev
